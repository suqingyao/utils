{
  "name": "@suqingyao/core",
  "version": "1.0.0",
  "private": true,
  "description": "personal monorepo",
  "license": "MIT",
  "author": "suqingyao",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:watch": "turbo run test:watch",
    "changeset": "changeset && changeset version",
    "release": "pnpm run build && changeset version && changeset publish",
    "preinstall": "npx only-allow pnpm"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^3.7.0",
    "@changesets/cli": "^2.29.7",
    "@suqingyao/tsconfig": "workspace:*",
    "eslint": "^9.15.0",
    "only-allow": "^1.2.1",
    "turbo": "^1.10.15",
    "typescript": "^5.2.2"
  },
  "packageManager": "pnpm@10.14.0",
  "engines": {
    "node": ">=18.0.0"
  }
}
