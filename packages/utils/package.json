{
  "name": "@suqingyao/utils",
  "type": "module",
  "version": "3.0.0",
  "description": "个人常用工具函数库",
  "author": "suqingyao",
  "license": "MIT",
  "keywords": [
    "utils",
    "typescript",
    "tools",
    "functions",
    "http"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "LICENSE",
    "README.md",
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint src --max-warnings 100",
    "lint:fix": "eslint src --fix",
    "test": "vitest"
  },
  "peerDependencies": {
    "typescript": "^5.2.2"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    }
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.0.0",
    "dayjs": "^1.11.10",
    "defu": "^6.1.4",
    "tailwind-merge": "^2.0.0"
  },
  "devDependencies": {
    "@suqingyao/tsconfig": "workspace:*",
    "@types/node": "^24.5.2",
    "happy-dom": "^19.0.2",
    "tsup": "^8.5.0",
    "vitest": "^3.2.4"
  },
  "publishConfig": {
    "access": "public"
  }
}
